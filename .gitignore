# Generated by Cargo
# will have compiled files and artifacts
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which should not be committed
.vs/

# Environment variables
# Ignore actual environment files with sensitive data
.env
.env.local
.env.*.local
.env.dev
.env.production
.env.staging

# Allow template/example files to be committed
# These files should NOT contain real API keys or secrets
!.env.example

# Sensitive credentials
*.pem
*.key
credentials.json

# IDE-specific files
.idea/
.vscode/

# Build artifacts
dist/
build/
