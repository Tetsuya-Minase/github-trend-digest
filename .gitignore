# Generated by Cargo
# will have compiled files and artifacts
/target/

# Remove Cargo.lock from gitignore if creating a library, leave it for binaries
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which should not be committed
.vs/

# Environment variables
.env
.env.*
!.env.example

# Sensitive credentials
*.pem
*.key
credentials.json

# IDE-specific files
.idea/
.vscode/

# Build artifacts
dist/
build/
